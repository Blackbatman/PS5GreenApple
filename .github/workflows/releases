name: Build and release ELF

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-elf:
    name: PS5 payload ELF
    runs-on: ubuntu-24.04
    env:
      PS5_PAYLOAD_SDK: /opt/ps5-sdk
    steps:
      - uses: actions/checkout@v5

      - name: Install LLVM toolchain
        run: |
          sudo apt-get update -q
          sudo apt-get install -y -q clang lld llvm cmake unzip wget

      - name: Restore PS5 SDK cache
        id: sdkcache
        uses: actions/cache@v4
        with:
          path: /opt/ps5-sdk
          key: ps5-sdk-0.44-llvm18-sdl2-v1

      - name: Install ps5-payload-sdk
        if: steps.sdkcache.outputs.cache-hit != 'true'
        run: |
          wget -q https://github.com/ps5-payload-dev/sdk/releases/latest/download/ps5-payload-sdk.zip \
              -O /tmp/ps5-payload-sdk.zip
          rm -rf "$PS5_PAYLOAD_SDK"
          unzip -q /tmp/ps5-payload-sdk.zip -d /opt
          mv /opt/ps5-payload-sdk "$PS5_PAYLOAD_SDK"
          "$PS5_PAYLOAD_SDK/bin/prospero-llvm-config" --version

      - name: Install SDL2 for PS5
        if: steps.sdkcache.outputs.cache-hit != 'true'
        run: |
          git clone --recursive --depth 1 https://github.com/ps5-payload-dev/SDL /tmp/SDL
          cd /tmp/SDL
          source "$PS5_PAYLOAD_SDK/toolchain/prospero.sh"
          if [ -f build-scripts/ps5-payload-sdk.sh ]; then
            "${CMAKE}" -DCMAKE_BUILD_TYPE=Release -B build-ps5 -S .
            "${MAKE}" -C build-ps5 -j"$(nproc)"
            DESTDIR= cmake --install build-ps5 --prefix "$PS5_PAYLOAD_SDK/target"
          else
            mkdir build && cd build
            ../configure --host=x86_64-pc-freebsd12-elf \
                --prefix="$PS5_PAYLOAD_SDK/target" --disable-shared --enable-static
            make -j"$(nproc)" && make install
          fi
          test -f "$PS5_PAYLOAD_SDK/target/lib/libSDL2.a"

      - name: Build ps5greenapple.elf
        run: |
          echo "$PS5_PAYLOAD_SDK/bin" >> "$GITHUB_PATH"
          make

      - name: Verify ELF
        run: |
          file ps5greenapple.elf
          readelf -d ps5greenapple.elf | grep NEEDED | head -12

      - name: Upload ELF artifact
        uses: actions/upload-artifact@v4
        with:
          name: ps5greenapple-elf
          path: ps5greenapple.elf

      - name: Publish release asset
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: ps5greenapple.elf
          generate_release_notes: true
